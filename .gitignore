# ==============================================================================
# ContinuumX Agentic Platform — Git Ignore Configuration
# ==============================================================================

# Python Bytecode, Caches & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/
ENV/
.env
.env.*

# Testing & Coverage Artifacts
.pytest_cache/
.coverage
htmlcov/

# Build Artifacts, Binaries & Packaging Files
build/
dist/
**/build/
**/dist/
*.exe
*.dll
*.so
*.dylib
*.pkg
*.toc
*.pyz
*.zip
*.spec
*.spec.bak
*.iss

# Platform Server & Runtime Database Storage
platform/data/
data/
**/data/
EmailStaging/
launcher_session.json
active_session.json

# Loose Duplicate Root Files in ref/
/ref/*.py
/ref/*.ps1
/ref/*.iss
/ref/*.spec
/ref/*.ini
/ref/*.txt
/ref/SERVER_DATA_STRUCTURE.md
/ref/AGENTS.md

# Downstream ref Modules (Excluded from Public Push; BOM & UI Prompts Tracked)
/ref/Costing/
/ref/Cycle Time/
/ref/NPI/
/ref/Project Management/
/ref/Sourcing/
/ref/WI/

# Module Runtime Logs, Caches & Temporary Storage
*.log
*.tmp
*.bak
**/WI_Log/
**/temp/
**/scratch/
scratch/
scratch_*.html

# Operating System & IDE Files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo


# Internal Documentation & Spec Guidelines
/AgenticPlatform/*.md
/AgenticPlatform/security/
/AGENTS.md
/SERVER_DATA_STRUCTURE.md